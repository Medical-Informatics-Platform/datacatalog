  "narrative": {
    "northStar": "The Transit Map",
    "overview": "Federations are lines, data models are stations, and every variable sits at the end of a route you can see. The system is a light, hairline-ruled reference tool for researchers who need to find one variable among hundreds. Structure comes from rows, rules and coloured lines; surfaces are white on a faintly blue-tinted canvas, and depth is almost absent.\n\nColour carries meaning. MIP blue is both the action colour and the default line colour. Each federation gets its own line colour, which follows it from the overview map into the explorer. Orange appears only as the \"you are here\" marker.",
    "keyCharacteristics": [
      "Rows and hairlines, not cards. Panels are bordered, never shadowed.",
      "Ink neutrals tinted toward brand blue; no pure grey, no pure black.",
      "Federation line colour is the one data-driven colour system.",
      "Codes, versions and variable names are always monospace.",
      "Sage-green brand well flush left in the header holds the blue MIP logo."
    ],
    "rules": [
      {
        "name": "The One Marker Rule",
        "body": "Orange marks the current position and nothing else. If orange appears on a button, badge or decoration, it is wrong.",
        "section": "colors"
      },
      {
        "name": "The Line Colour Rule",
        "body": "A federation's colour is assigned once and follows it everywhere (map, directory row edge, column row edge, route strip). Never reuse a line colour for status.",
        "section": "colors"
      },
      {
        "name": "The Draft Is Dashed Rule",
        "body": "Draft state is amber with a dashed edge, Released is green and solid; state is never colour alone.",
        "section": "colors"
      },
      {
        "name": "The Mono For Codes Rule",
        "body": "Anything that is an identifier (federation code, pathology code, version, variable code) is set in Atkinson Mono.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Counts and metrics use tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Shadows Only On Overlays Rule",
        "body": "If something is in the page flow, it has a border, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use rows and hairlines (1px #e8eaf3 / #d9dceb) to separate content.",
      "Do colour a federation consistently with its assigned line colour everywhere it appears.",
      "Do set every code, version and variable name in the mono face.",
      "Do keep Released solid green and Draft dashed amber, with the word on the badge.",
      "Do use `.on-dark` so focus rings turn orange on the footer.",
      "Do honour reduced motion (durations go to 0)."
    ],
    "donts": [
      "Don't use orange for anything other than the current-position marker.",
      "Don't put shadows on in-flow surfaces; shadows are for overlays only.",
      "Don't use hero-metric cards, gradients or glass; metrics are a ruled strip.",
      "Don't redraw, recolour or place the logo on any ground other than sage (#dfefe4) or the footer ground (#2d2d2b).",
      "Don't use `window.alert` or `window.confirm`; use dialogs, drawers and toasts."
    ]
  }
